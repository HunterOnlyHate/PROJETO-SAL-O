{
  "version": 2,
  "name": "glamour-studio-salao",
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/produtos", "destination": "/produtos.html" },
    { "source": "/agendar", "destination": "/agendar.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
